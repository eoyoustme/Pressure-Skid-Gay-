local function isPointInBox(point, boxCFrame, boxSize)
	local localPos = boxCFrame:PointToObjectSpace(point)
	return math.abs(localPos.X) <= boxSize.X / 2
		and math.abs(localPos.Y) <= boxSize.Y / 2
		and math.abs(localPos.Z) <= boxSize.Z / 2
end

local function getRoomNumberFromModel(roomModel)
	local lights = roomModel:FindFirstChild("Lights")
	if lights then
		local sign = lights:FindFirstChild("Sign", true)
		if sign then
			local textLabel = sign:FindFirstChildWhichIsA("TextLabel", true)
			if textLabel then
				local num = tonumber(textLabel.Text)
				if num then return num end
			end
		end
	end

	for _, desc in ipairs(roomModel:GetDescendants()) do
		if desc:IsA("TextLabel") then
			local num = tonumber(desc.Text)
			if num then return num end
		end
	end

	return nil
end

-- HÀM LẤY VÀ SẮP XẾP TẤT CẢ PHÒNG THEO SỐ PHÒNG
local function getSortedRooms()
	local rooms = {}
	for _, roomModel in ipairs(RoomsFolder:GetChildren()) do
		if roomModel:IsA("Model") then
			local roomNum = getRoomNumberFromModel(roomModel)
			if roomNum then
				table.insert(rooms, {Model = roomModel, Number = roomNum})
			end
		end
	end

	table.sort(rooms, function(a, b)
		return a.Number < b.Number
	end)

	return rooms
end

-- HÀM TÌM INDEX PHÒNG CỦA PLAYER
local function getPlayerRoomIdx(sortedRooms, hrp)
	if not hrp or #sortedRooms == 0 then return 1 end

	-- 1. Kiểm tra player nằm trong BoundingBox phòng nào
	for i, roomData in ipairs(sortedRooms) do
		local model = roomData.Model
		if model then
			local cframe, size = model:GetBoundingBox()
			if isPointInBox(hrp.Position, cframe, size) then
				return i
			end
		end
	end

	-- 2. Nếu không nằm trực tiếp trong box nào, chọn phòng gần nhất
	local closestIdx = 1
	local closestDist = math.huge

	for i, roomData in ipairs(sortedRooms) do
		local model = roomData.Model
		if model then
			local cframe = model:GetBoundingBox()
			local dist = (hrp.Position - cframe.Position).Magnitude
			if dist < closestDist then
				closestDist = dist
				closestIdx = i
			end
		end
	end

	return closestIdx
end

