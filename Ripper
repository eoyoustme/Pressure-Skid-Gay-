local function getRoomFromDescendant(instance)
	if not instance then return nil end
	local current = instance
	while current and current.Parent ~= RoomsFolder do
		current = current.Parent
	end
	return current
end

local function getRoomNumber(roomModel)
	if not roomModel then return nil end
	local sign = roomModel:FindFirstChild("Sign", true)
	if sign then
		local textLabel = sign:FindFirstChildWhichIsA("TextLabel", true)
		if textLabel and tonumber(textLabel.Text) then
			return tonumber(textLabel.Text)
		end
	end

	for _, desc in ipairs(roomModel:GetDescendants()) do
		if desc:IsA("TextLabel") and tonumber(desc.Text) then
			return tonumber(desc.Text)
		end
	end

	return tonumber(roomModel.Name)
end

-- XÁC ĐỊNH CHÍNH XÁC PHÒNG PLAYER ĐANG ĐỨNG BẰNG RAYCAST BẮN THẲNG XUỐNG SÀN
local function getPlayerRoom()
	local character = LocalPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end

	-- 1. Raycast thẳng xuống mặt đất để tìm chính xác Model phòng bên dưới chân Player
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = {character}

	local rayResult = workspace:Raycast(hrp.Position, Vector3.new(0, -30, 0), raycastParams)
	if rayResult and rayResult.Instance then
		local room = getRoomFromDescendant(rayResult.Instance)
		if room then
			return room
		end
	end

	-- 2. Phương án dự phòng nếu Player đang nhảy/bay
	local closestRoom = nil
	local minDistance = math.huge

	for _, roomModel in ipairs(RoomsFolder:GetChildren()) do
		if roomModel:IsA("Model") then
			local success, cf, size = pcall(function() return roomModel:GetBoundingBox() end)
			if success and cf then
				local localPos = cf:PointToObjectSpace(hrp.Position)
				local halfSize = size / 2

				if math.abs(localPos.X) <= halfSize.X + 5 and
					math.abs(localPos.Y) <= halfSize.Y + 10 and
					math.abs(localPos.Z) <= halfSize.Z + 5 then
					return roomModel
				end

				local dist = (hrp.Position - cf.Position).Magnitude
				if dist < minDistance then
					minDistance = dist
					closestRoom = roomModel
				end
			end
		end
	end

	return closestRoom
end

local function getSortedRooms()
	local rooms = {}
	forbiddenRooms = {}

	local maxNum = -math.huge

	for _, roomModel in ipairs(RoomsFolder:GetChildren()) do
		if roomModel:IsA("Model") then
			local num = getRoomNumber(roomModel)
			if num then
				table.insert(rooms, {Model = roomModel, Number = num})
				if num > maxNum then
					maxNum = num
				end
			end
		end
	end

	if #rooms == 0 then return {} end

	local targetMaxNum = maxNum - 1

	local validRooms = {}
	for _, roomData in ipairs(rooms) do
		if roomData.Number <= targetMaxNum then
			table.insert(validRooms, roomData)
		else
			forbiddenRooms[roomData.Model] = true
		end
	end

	table.sort(validRooms, function(a, b)
		return a.Number > b.Number
	end)

	return validRooms
end

