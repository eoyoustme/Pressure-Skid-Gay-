	local function getSortedRooms()
		local rooms = {}
		for _, roomModel in ipairs(RoomsFolder:GetChildren()) do
			if roomModel:IsA("Model") then
				local lights = roomModel:FindFirstChild("Lights")
				if lights then
					local sign = lights:FindFirstChild("Sign", true)
					if sign and sign:FindFirstChild("SurfaceGui") and sign.SurfaceGui:FindFirstChild("TextLabel") then
						local roomNum = tonumber(sign.SurfaceGui.TextLabel.Text)
						if roomNum then
							table.insert(rooms, {Model = roomModel, Number = roomNum})
						end
					end
				end
			end
		end

		table.sort(rooms, function(a, b)
			return a.Number > b.Number
		end)

		return rooms
	end

	local function isPointInBox(point, boxCFrame, boxSize)
		local localPos = boxCFrame:PointToObjectSpace(point)
		return math.abs(localPos.X) <= boxSize.X / 2
			and math.abs(localPos.Y) <= boxSize.Y / 2
			and math.abs(localPos.Z) <= boxSize.Z / 2
	end

	local function getPlayerRoomIdx(sortedRooms, hrp)
		if not hrp then return 1 end

		for i, roomData in ipairs(sortedRooms) do
			local model = roomData.Model
			if model then
				local cframe, size = model:GetBoundingBox()
				if isPointInBox(hrp.Position, cframe, size) then
					return i
				end
			end
		end

		local closestIdx = 1
		local closestDist = math.huge

		for i, roomData in ipairs(sortedRooms) do
			local model = roomData.Model
			if model then
				local cframe = model:GetBoundingBox()
				local dist = (hrp.Position - cframe.Position).Magnitude
				if dist < closestDist then
					closestDist = dist
					closestIdx = i
				end
			end
		end

		return closestIdx
	end

	local wasInPlayerRoom = false
	local windTween = nil

	local function calculateEntitySpeed(baseSpeed, entityRoomIdx, sortedRooms, hrp, entityModel)
		if not hrp or not entityModel then
			return baseSpeed * 4
		end

		local playerRoomIdx = getPlayerRoomIdx(sortedRooms, hrp)
		local isInPlayerRoom = (entityRoomIdx == playerRoomIdx)

		if isInPlayerRoom and not wasInPlayerRoom then
			wasInPlayerRoom = true

			if windTween then
				windTween:Cancel()
				windTween = nil
			end
		elseif not isInPlayerRoom and wasInPlayerRoom then
			wasInPlayerRoom = false
		end

		-- Trả về tốc độ tương ứng
		if isInPlayerRoom then
			return baseSpeed
		else
			return baseSpeed * 4
		end
	end

