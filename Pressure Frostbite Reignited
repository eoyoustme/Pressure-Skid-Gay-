local function getPreviousRoom(currentRoom)
	local roomNum = tonumber(currentRoom.Name)
	if roomNum then
		local prevRoom = RoomsFolder:FindFirstChild(tostring(roomNum - 1))
		if prevRoom then return prevRoom end
	end

	local allRooms = RoomsFolder:GetChildren()
	for i, room in ipairs(allRooms) do
		if room == currentRoom and i > 1 then
			return allRooms[i - 1]
		end
	end

	return currentRoom
end

local function getCeilingLights(roomModel)
	local lights = {}
	local searchTarget = roomModel:FindFirstChild("Lights") or roomModel

	for _, desc in ipairs(searchTarget:GetDescendants()) do
		if desc:IsA("BasePart") then
			local nameLower = desc.Name:lower()
			local isIgnored = nameLower:find("floor") or nameLower:find("tile") or nameLower:find("grid") or nameLower:find("rack") or nameLower:find("server") or nameLower:find("ground")

			if not isIgnored then
				local isNeon = (desc.Material == Enum.Material.Neon)
				local isLightName = nameLower:find("light") or nameLower:find("lamp") or nameLower:find("bulb") or nameLower:find("fixture")

				if isNeon or isLightName then
					table.insert(lights, desc)
				end
			end
		end
	end

	return lights
end

local function getRoomCFrame(roomModel)
	if not roomModel then return nil end

	local entityNodes = roomModel:FindFirstChild("EntityNodes")
	if entityNodes then
		local node = entityNodes:FindFirstChild("Node") or entityNodes:FindFirstChildWhichIsA("BasePart")
		if node and node:IsA("BasePart") then
			return node.CFrame
		end
	end

	local floor = roomModel:FindFirstChild("Floor", true) or roomModel:FindFirstChildWhichIsA("BasePart", true)
	if floor then
		return floor.CFrame
	end

	return roomModel:GetPivot()
end

local function caycaycay(TweenBig, ShowStrong, TweenShrinking, MaxStrength, MaxRoughness)
	MaxStrength = MaxStrength or 6
	MaxRoughness = MaxRoughness or 50

	local TotalDuration = TweenBig + ShowStrong + TweenShrinking
	local elapsedTime = 0
	local tickCount = 0

	local connection
	connection = RunService.RenderStepped:Connect(function(deltaTime)
		elapsedTime = elapsedTime + deltaTime

		if elapsedTime >= TotalDuration then
			connection:Disconnect()
			return
		end

		local currentStrength = 0

		if elapsedTime <= TweenBig then
			local progress = elapsedTime / (TweenBig > 0 and TweenBig or 0.001)
			local eased = TweenService:GetValue(progress, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			currentStrength = MaxStrength * eased
		elseif elapsedTime <= (TweenBig + ShowStrong) then
			currentStrength = MaxStrength
		else
			local progress = (elapsedTime - TweenBig - ShowStrong) / (TweenShrinking > 0 and TweenShrinking or 0.001)
			local eased = TweenService:GetValue(progress, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			currentStrength = MaxStrength * (1 - eased)
		end

		tickCount = tickCount + deltaTime * MaxRoughness

		local noiseVal = Vector3.new(
			math.noise(tickCount, 0) * 0.5,
			math.noise(0, tickCount) * 0.5,
			math.noise(tickCount, tickCount) * 0.5
		)

		local shakeVector = noiseVal * currentStrength
		local posAccumulator = shakeVector * Vector3.new(0.05, 0.05, 0.05)
		local rotAccumulator = shakeVector * Vector3.new(1, 1, 1)

		local shakeCFrame = CFrame.new(posAccumulator) * CFrame.Angles(
			math.rad(rotAccumulator.X),
			math.rad(rotAccumulator.Y),
			math.rad(rotAccumulator.Z)
		)

		Camera.CFrame = Camera.CFrame * shakeCFrame
	end)

	return connection
end

local function applyDamage(number)
	local character = LocalPlayer.Character
	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end

	local damageAmount = (type(number) == "number") and number or 5

	if humanoid.Health - damageAmount < 1 then
		damageAmount = math.max(0, humanoid.Health - 1)
	end

	if damageAmount <= 0 then return end

	local damageRemote = ReplicatedStorage:FindFirstChild("LocalDamage", true) or ReplicatedStorage:FindFirstChild("ChangeHealth", true)

	if damageRemote then
		if damageRemote.Name == "LocalDamage" then
			damageRemote:FireServer(damageAmount, "SittingItOut", 1, nil)
		else
			damageRemote:FireServer("Damage", damageAmount)
		end
	else
		humanoid:TakeDamage(damageAmount)
	end
end

