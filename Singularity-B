function getgithubmodeL(url)
	if not (writefile and getcustomasset and httpRequest) then return nil end
	local fileName = string.match(url, "([^/]+)$") or "temp_model.rbxm"
	local response = httpRequest({Url = url, Method = "GET"})
	if not response or response.StatusCode ~= 200 then return nil end
	writefile(fileName, response.Body)
	local assetId = getcustomasset(fileName)

	local success, result = pcall(function() return game:GetObjects(assetId) end)
	return success and result or nil
end

