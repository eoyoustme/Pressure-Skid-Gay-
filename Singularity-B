	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	overlapParams.FilterDescendantsInstances = {s, char}

	local nearbyParts = workspace:GetPartBoundsInRadius(entityPos, 60, overlapParams)

	for _, part in ipairs(nearbyParts) do
		local nameLower = string.lower(part.Name)
		if nameLower:find("floor") or nameLower:find("wall") or nameLower:find("keyhitbox") or nameLower:find("door") or part.Locked then
			continue
		end

		local parent = part.Parent
		if parent and parent:IsA("Model") and parent ~= workspace then
			if not processedModels[parent] then
				processedModels[parent] = true
				local modelPos = parent:GetPivot().Position
				local dist = (modelPos - entityPos).Magnitude
				table.insert(targets, {instance = parent, distance = dist, isModel = true, isPlayer = false})
			end
		else
			if not processedParts[part] then
				processedParts[part] = true
				local dist = (part.Position - entityPos).Magnitude
				table.insert(targets, {instance = part, distance = dist, isModel = false, isPlayer = false})
			end
		end
	end

	table.sort(targets, function(a, b) return a.distance < b.distance end)

	local maxPull = math.min(#targets, Random.new():NextInteger(1 , 6))
	local instancesToDestroy = {}

	local chainStart1 = entity:FindFirstChild("ChainStart", true) or s:FindFirstChild("ChainStart", true)

	local templateChains = {}
	if chainStart1 and chainStart1:FindFirstChild("SingularityChain") then
		table.insert(templateChains, {origin = chainStart1, beam = chainStart1.SingularityChain})
	end

	local createdBeams = {}
	local createdAttachments = {}
	local playerChained = false

	for i = 1, maxPull do
		local target = targets[i]
