local function findLockerInRoom(room)
	local candidates = {}

	for _, desc in ipairs(room:GetDescendants()) do
		if desc:IsA("Model") then
			local n = string.lower(desc.Name)
			if n:find("locker") or n:find("wardrobe") or n:find("closet") then
				table.insert(candidates, desc)
			end
		end
	end

	-- Nếu không có Model tên Locker, tìm trong LockersOnly hoặc Interactables
	if #candidates == 0 then
		for _, desc in ipairs(room:GetDescendants()) do
			if desc:IsA("Folder") and (desc.Name == "LockersOnly" or desc.Name == "Interactables" or desc.Name == "Locations") then
				for _, child in ipairs(desc:GetChildren()) do
					if child:IsA("Model") or child:IsA("BasePart") then
						table.insert(candidates, child)
					end
				end
			end
		end
	end

	for _, cand in ipairs(candidates) do
		local targetObj = cand:FindFirstChild("Vaule") 
			or cand:FindFirstChild("Value") 
			or cand:FindFirstChild("Main") 
			or cand:FindFirstChild("Root") 
			or cand

		local cf = nil
		if targetObj:IsA("BasePart") then
			cf = targetObj.CFrame
		elseif targetObj:IsA("CFrameValue") then
			cf = targetObj.Value
		elseif targetObj:IsA("Model") then
			local main = targetObj.PrimaryPart or targetObj:FindFirstChildWhichIsA("BasePart", true)
			cf = main and main.CFrame or targetObj:GetPivot()
		end

		-- Đảm bảo CFrame không thuộc vùng dưới vực (-100 studs)
		if cf and cf.Position.Y > -100 then
			return cand, cf
		end
	end

	return nil, nil
end

local function applyDamage(number)
	local character = game.Players.LocalPlayer.Character
	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end

	local damageAmount = (type(number) == "number") and number or 5

	if humanoid.Health - damageAmount < 1 then
		damageAmount = math.max(0, humanoid.Health - 1)
	end

	if damageAmount <= 0 then return end

	local damageRemote = game.ReplicatedStorage:FindFirstChild("LocalDamage", true) or game.ReplicatedStorage:FindFirstChild("ChangeHealth", true)

	if damageRemote then
		if damageRemote.Name == "LocalDamage" then
			damageRemote:FireServer(damageAmount, "SittingItOut", 1, nil)
		else
			damageRemote:FireServer("Damage", damageAmount)
		end
	else
		humanoid:TakeDamage(damageAmount)
	end
end

