	local function startCameraShake(mainPart, shakerConfig)
		local HowFar = shakerConfig.HowFar
		local MaxStrength = shakerConfig.Strength or shakerConfig.Strengh or 7.5
		local MaxRoughness = shakerConfig.Roughness or 60

		local minDist = HowFar / 10
		local tick = 0

		local connection
		connection = RunService.RenderStepped:Connect(function(deltaTime)
			if not mainPart or not mainPart.Parent then
				connection:Disconnect()
				return
			end

			local character = LocalPlayer.Character
			local hrp = character and character:FindFirstChild("HumanoidRootPart")
			if not hrp then return end

			local dist = (hrp.Position - mainPart.Position).Magnitude

			if dist <= HowFar then
				local rawProgress = math.clamp(1 - ((dist - minDist) / (HowFar - minDist)), 0, 1)
				local easedProgress = TweenService:GetValue(rawProgress, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

				local currentStrength = MaxStrength * easedProgress
				local currentRoughness = MaxRoughness * easedProgress

				tick = tick + deltaTime * currentRoughness

				local noiseVal = Vector3.new(
					math.noise(tick, 0) * 0.5,
					math.noise(0, tick) * 0.5,
					math.noise(tick, tick) * 0.5
				)

				local shakeVector = noiseVal * currentStrength
				local posAccumulator = shakeVector * Vector3.new(0.05, 0.05, 0.05)
				local rotAccumulator = shakeVector * Vector3.new(1, 1, 1)

				local shakeCFrame = CFrame.new(posAccumulator) * CFrame.Angles(
					math.rad(rotAccumulator.X),
					math.rad(rotAccumulator.Y),
					math.rad(rotAccumulator.Z)
				)

				Camera.CFrame = Camera.CFrame * shakeCFrame
			end
		end)

		return connection
	end

