	local function spawnEntity()
		local sortedRooms = getSortedRooms()
		if #sortedRooms == 0 then return end

		if entity.Flicker then
			task.spawn(function()
				triggerLightFlicker(entity.FlickerDur or 2)
			end)
		end

		task.wait(entity.Delay)

		local function getgithubmodel(url)
			if string.find(url, "github.com") and string.find(url, "/blob/") then
				url = string.gsub(url, "github%.com", "raw.githubusercontent.com")
				url = string.gsub(url, "/blob/", "/")
			elseif string.find(url, "github.com") and not string.find(url, "%?raw=true") then
				url = url .. "?raw=true"
			end

			local httpRequest = (type(request) == "function" and request) 
				or (http and type(http.request) == "function" and http.request) 
				or (syn and type(syn.request) == "function" and syn.request)
				or (http_request)

			if not (writefile and getcustomasset and httpRequest) then 
				return nil 
			end

			local cleanUrl = string.split(url, "?")[1]
			local fileName = string.match(cleanUrl, "([^/]+)$") or "temp_model.rbxm"
			if not string.find(fileName, "%.rbxm$") and not string.find(fileName, "%.rbxmx$") then
				fileName = fileName .. ".rbxm"
			end

			local response = httpRequest({Url = url, Method = "GET"})
			if not response or response.StatusCode ~= 200 or not response.Body then 
				return nil 
			end

			writefile(fileName, response.Body)

			local assetId = getcustomasset(fileName)
			local success, result = pcall(function() 
				return game:GetObjects(assetId)[1] 
			end)

			if success and result then
				return result
			end

			local success2, result2 = pcall(function()
				return game:GetService("InsertService"):LoadLocalAsset(fileName)
			end)

			if success2 and result2 then
				return result2
			end

			return nil
		end

		local entityModel = getgithubmodel(entity.EntityModel)
		if not entityModel then 
			return 
		end

		local mainPart = entityModel:IsA("BasePart") and entityModel or entityModel:FindFirstChildWhichIsA("BasePart")

		if not mainPart then
			if entityModel then entityModel:Destroy() end
			return
		end

		local attackSnd = mainPart:FindFirstChild("Attack")
		if attackSnd and attackSnd:IsA("Sound") then
			attackSnd:Stop()
		end

		local firstRoom = sortedRooms[1]
		if firstRoom and firstRoom.Model then
			local entityNodes = firstRoom.Model:FindFirstChild("EntityNodes")
			local entranceNode = entityNodes and entityNodes:FindFirstChild("Exit")

			if entranceNode then
				mainPart.CFrame = entranceNode.CFrame + Vector3.new(0, entity.HeightOfOffset, 0)
			end
		end

		entityModel.Parent = workspace
		startCameraShake(mainPart, entity.CameraShaker)

		local effectiveHitbox = (entity.PandemoniumMove or entity.PipSqueakMove) and (entity.Hitbox / 10) or entity.Hitbox
		local hasSlammedLocker = false

		for reboundCount = 0, entity.Rebounding do
			local isRebounding = (reboundCount % 2 == 1)

			local startRoomIdx = isRebounding and #sortedRooms or 1
			local endRoomIdx = isRebounding and 1 or #sortedRooms
			local step = isRebounding and -1 or 1

			for roomIdx = startRoomIdx, endRoomIdx, step do
				local roomData = sortedRooms[roomIdx]
				local roomModel = roomData.Model

				if entity.BreakLight then
					task.spawn(function()
						breakRoomLights(roomModel)
					end)
				end

				local entityNodes = roomModel:FindFirstChild("EntityNodes")
				if not entityNodes then continue end

				local startNodeName = isRebounding and "Exit" or "Entrance"
				local endNodeName = isRebounding and "Entrance" or "Exit"
				local connectionKey = isRebounding and "Previous" or "Next"

				local currentNode = entityNodes:FindFirstChild(startNodeName)
				if not currentNode then continue end

				while currentNode do
					local targetPos = currentNode.Position + Vector3.new(0, entity.HeightOfOffset, 0)

					while (mainPart.Position - targetPos).Magnitude > 1 do
						local dt = RunService.RenderStepped:Wait()
						local direction = (targetPos - mainPart.Position).Unit
						local moveStep = direction * entity.Speed * dt

						if (targetPos - mainPart.Position).Magnitude < moveStep.Magnitude then
							mainPart.CFrame = CFrame.new(targetPos)
						else
							mainPart.CFrame = CFrame.new(mainPart.Position + moveStep)
						end

						local character = LocalPlayer.Character
						local hrp = character and character:FindFirstChild("HumanoidRootPart")

						if hrp then
							if entity.PipSqueakMove then
								if isPlayerInLocker() then
									if not hasSlammedLocker then
										local rayOrigin = mainPart.Position
										local rayDirection = (hrp.Position - rayOrigin)

										local raycastParams = RaycastParams.new()
										raycastParams.FilterType = Enum.RaycastFilterType.Exclude
										raycastParams.FilterDescendantsInstances = {entityModel}

										local rayResult = workspace:Raycast(rayOrigin, rayDirection, raycastParams)

										if rayResult and rayResult.Instance then
											hasSlammedLocker = true 

											local targetCFrame = hrp.CFrame * CFrame.new(0, 0, 4)
											local chaseDistance = (targetCFrame.Position - mainPart.Position).Magnitude
											local duration = chaseDistance / (entity.Speed * 1.2)
											if duration <= 0 then duration = 0.05 end

											local chaseTween = TweenService:Create(
												mainPart,
												TweenInfo.new(duration, Enum.EasingStyle.Linear),
												{CFrame = targetCFrame}
											)
											chaseTween:Play()
											local atkSound = mainPart:FindFirstChild("Attack")
											local idleSound = mainPart:FindFirstChild("Idle")
											local eyesEffect = mainPart:FindFirstChild("PandemoniumEyes", true)

											if atkSound and atkSound:IsA("Sound") then atkSound:Play() end
											if idleSound and idleSound:IsA("Sound") then idleSound:Stop() end
											if eyesEffect then eyesEffect.Enabled = true end
											chaseTween.Completed:Wait()

											caycaycay(0.577, 5.771, 1, 5, 5)

											local waitTime = entity.PipSqueakDelay or 2
											if entity.SoundSlamPipSqueak and entity.SoundSlamPipSqueak ~= "rbxassetid://0" and entity.SoundSlamPipSqueak ~= "" then
												local slamSnd = Instance.new("Sound")
												slamSnd.SoundId = entity.SoundSlamPipSqueak
												slamSnd.Volume = 5
												slamSnd.Parent = workspace
												slamSnd:Play()

												if not slamSnd.IsLoaded then
													slamSnd.Loaded:Wait()
												end

												if slamSnd.TimeLength and slamSnd.TimeLength > 0 then
													waitTime = slamSnd.TimeLength
												end

												game:GetService("Debris"):AddItem(slamSnd, waitTime + 1)
											end

											task.wait(waitTime)

											if atkSound and atkSound:IsA("Sound") then atkSound:Stop() end
											if idleSound and idleSound:IsA("Sound") then idleSound:Play() end
											if eyesEffect then eyesEffect.Enabled = false end
										end
									end
								else
									hasSlammedLocker = false

									local rayOrigin = mainPart.Position
									local rayDirection = (hrp.Position - rayOrigin)

									local raycastParams = RaycastParams.new()
									raycastParams.FilterType = Enum.RaycastFilterType.Exclude
									raycastParams.FilterDescendantsInstances = {entityModel}

									local rayResult = workspace:Raycast(rayOrigin, rayDirection, raycastParams)

									if rayResult and rayResult.Instance and rayResult.Instance:IsDescendantOf(character) then
										handlePlayerDeath(entityModel)
										break
									end
								end
							end

							if entity.PandemoniumMove and not isPlayerInLocker() then
								local rayOrigin = mainPart.Position
								local rayDirection = (hrp.Position - rayOrigin)

								local raycastParams = RaycastParams.new()
								raycastParams.FilterType = Enum.RaycastFilterType.Exclude
								raycastParams.FilterDescendantsInstances = {entityModel}

								local rayResult = workspace:Raycast(rayOrigin, rayDirection, raycastParams)

								if rayResult and rayResult.Instance and rayResult.Instance:IsDescendantOf(character) then
									local silenceModel = workspace:FindFirstChild("Model")
									local movePart = (silenceModel and (silenceModel:FindFirstChild("Pandemonium") or silenceModel:FindFirstChildWhichIsA("BasePart"))) or mainPart
									movePart.Anchored = true

									while character and character:FindFirstChild("HumanoidRootPart") and not isPlayerInLocker() do
										local currentHrp = character.HumanoidRootPart
										local distToPlayer = (currentHrp.Position - movePart.Position).Magnitude

										if distToPlayer <= (effectiveHitbox / 2) then
											handlePlayerDeath(entityModel)
											break
										end

										local targetCFrame = currentHrp.CFrame * CFrame.new(0, 2, 0)
										local distance = (targetCFrame.Position - movePart.Position).Magnitude
										local SPEED_STUDS_PER_SECOND = 15
										local duration = distance / SPEED_STUDS_PER_SECOND

										if duration <= 0 then duration = 0.05 end

										local tween = TweenService:Create(
											movePart,
											TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut),
											{CFrame = targetCFrame}
										)

										tween:Play()
										tween.Completed:Wait()

										if (currentHrp.Position - movePart.Position).Magnitude <= (effectiveHitbox / 2) then
											handlePlayerDeath(entityModel)
											break
										end
									end
								end
							end

							local distance = (hrp.Position - mainPart.Position).Magnitude
							if distance <= (effectiveHitbox / 2) then
								if not isPlayerInLocker() then
									task.wait(0.1)
									handlePlayerDeath(entityModel)
								end
							end
						end
					end

					local connections = currentNode:FindFirstChild("Connections")
					local nextVal = connections and connections:FindFirstChild(connectionKey)

					if nextVal and nextVal.Value then
						if typeof(nextVal.Value) == "Instance" and nextVal.Value:IsA("BasePart") then
							currentNode = nextVal.Value
						elseif typeof(nextVal.Value) == "string" then
							if nextVal.Value == endNodeName then
								local targetEndNode = entityNodes:FindFirstChild(endNodeName)
								if targetEndNode and currentNode ~= targetEndNode then
									currentNode = targetEndNode
								else
									currentNode = nil
								end
							else
								currentNode = entityNodes:FindFirstChild(nextVal.Value)
							end
						else
							currentNode = nil
						end
					else
						currentNode = nil
					end
				end
			end
		end

		if entityModel and entityModel.Parent then
			entityModel:Destroy()
			local vauke = Instance.new("BoolValue")
			vauke.Parent = workspace
			vauke.Name = "vauke"
		end
	end

	task.spawn(spawnEntity)
end

task.spawn(function()
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local TweenService = game:GetService("TweenService")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local LocalPlayer = Players.LocalPlayer
	local Camera = workspace.CurrentCamera

	local function caycaycay(TweenBig, ShowStrong, TweenShrinking, MaxStrength, MaxRoughness)
		MaxStrength = MaxStrength or 7.5
		MaxRoughness = MaxRoughness or 60

		local TotalDuration = TweenBig + ShowStrong + TweenShrinking
		local elapsedTime = 0
		local tickCount = 0

		local connection
		connection = RunService.RenderStepped:Connect(function(deltaTime)
			elapsedTime = elapsedTime + deltaTime

			if elapsedTime >= TotalDuration then
				connection:Disconnect()
				return
			end

			local currentStrength = 0

			if elapsedTime <= TweenBig then
				local progress = elapsedTime / (TweenBig > 0 and TweenBig or 0.001)
				local eased = TweenService:GetValue(progress, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
				currentStrength = MaxStrength * eased

			elseif elapsedTime <= (TweenBig + ShowStrong) then
				currentStrength = MaxStrength

			else
				local progress = (elapsedTime - TweenBig - ShowStrong) / (TweenShrinking > 0 and TweenShrinking or 0.001)
				local eased = TweenService:GetValue(progress, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				currentStrength = MaxStrength * (1 - eased)
			end

			tickCount = tickCount + deltaTime * MaxRoughness

			local noiseVal = Vector3.new(
				math.noise(tickCount, 0) * 0.5,
				math.noise(0, tickCount) * 0.5,
				math.noise(tickCount, tickCount) * 0.5
			)

			local shakeVector = noiseVal * currentStrength
			local posAccumulator = shakeVector * Vector3.new(0.05, 0.05, 0.05)
			local rotAccumulator = shakeVector * Vector3.new(1, 1, 1)

			local shakeCFrame = CFrame.new(posAccumulator) * CFrame.Angles(
				math.rad(rotAccumulator.X),
				math.rad(rotAccumulator.Y),
				math.rad(rotAccumulator.Z)
			)

			Camera.CFrame = Camera.CFrame * shakeCFrame
		end)

		return connection
	end

